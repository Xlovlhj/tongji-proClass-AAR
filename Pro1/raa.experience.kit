# Local Isaac Sim 6 experience for robot arm artist.
# ISAAC_PATH is set by raa.runtime; extension lookup uses the installed bundle.
# This file deliberately has no dependency on isaacsim.exp.base.

[package]
title = "robot arm artist · raa-v0"
description = "Panda torque control, local URDF import, Lula IK and one viewport"
version = "0.1.0"

[dependencies]
"isaacsim.simulation_app" = {}
"isaacsim.core.api" = {}
"isaacsim.core.experimental.prims" = {}
"isaacsim.core.experimental.primdata" = {}
"isaacsim.robot_motion.motion_generation" = {}
"isaacsim.asset.importer.urdf" = {}

# One interactive viewport, also available for capture in --headless mode.
"omni.kit.loop-isaac" = {}
"omni.kit.mainwindow" = {}
"omni.kit.viewport.window" = {}
"omni.kit.viewport.utility" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.renderer.core" = {}
"omni.kit.renderer.capture" = {}
"omni.hydra.rtx" = {}
"omni.physx.fabric" = {}

[settings]
exts."isaacsim.core.simulation_manager".default_engine = "physx"
exts."isaacsim.core.experimental.prims".prim_data_reader_provider_extension = "isaacsim.core.experimental.primdata"
exts."omni.usd".locking.onClose = false
exts."omni.kit.renderer.core".present.enabled = false
exts."omni.kit.viewport.window".startup.windowName = "robot arm artist"
exts."omni.kit.viewport.window".windowMenu.entryCount = 1
exts."omni.kit.viewport.window".startup.disableWindowOnLoad = false
exts."omni.kit.viewport.window".startup.selectionManipulator.enabled = false
renderer.asyncInit = true
renderer.gpuEnumeration.glInterop.enabled = false
renderer.multiGpu.enabled = false
renderer.multiGpu.autoEnable = false
foundation.verifyOsVersion.enabled = false
physics.autoPopupSimulationOutputWindow = false
rtx.rendermode = "MinimalRendering"
rtx.minimal.mode = 3
rtx.sceneDb.ambientLightIntensity = 0.2
rtx.sceneDb.ambientLightColor = [1.0, 1.0, 1.0]
rtx.post.aa.op = 0
rtx-transient.dlssg.enabled = false
omnihydra.parallelHydraSprimSync = true

[settings.app]
name = "robot-arm-artist"
version = "0.1.0"
window.title = "robot arm artist · raa-v0"
vulkan = true
content.emptyStageOnStart = true
fastShutdown = true
file.ignoreUnsavedStage = true
settings.persistent = false
settings.fabricDefaultStageFrameHistoryCount = 3
useFabricSceneDelegate = true
events.qualifiedNames = true
enableDeveloperWarnings = false
asyncRendering = false
asyncRenderingLowLatency = false
runLoops.main.rateLimitEnabled = false
runLoops.main.manualModeEnabled = true
player.useFixedTimeStepping = false
renderer.skipWhileMinimized = false
renderer.skipWhileInvisible = false
renderer.sleepMsOnFocus = 0
renderer.sleepMsOutOfFocus = 0
renderer.resolution.width = 960
renderer.resolution.height = 720
viewport.defaults.fillViewport = true
viewport.grid.enabled = false
viewport.outline.enabled = false
viewport.boundingBoxes.enabled = false
viewport.show.camera = false
viewport.show.lights = false

[settings.app.exts.folders]
'++' = [
    "${env:ISAAC_PATH}/exts",
    "${env:ISAAC_PATH}/extscache",
    "${env:ISAAC_PATH}/extsDeprecated",
    "${env:ISAAC_PATH}/apps",
]

[settings.persistent]
app.stage.upAxis = "Z"
app.stage.timeCodeRange = [0, 1000000]
simulation.defaultMetersPerUnit = 1.0
physics.visualizationDisplayJoints = false
physics.visualizationSimulationOutput = false
physics.resetOnStop = true
renderer.startupMessageDisplayed = true
app.viewport.camMoveVelocity = 0.05
app.viewport.camVelocityMin = 0.0001
app.viewport.camVelocityMax = 0.2
