{
  "schema_version": 1,
  "algorithm": "nonlinear_srbd_sqp_rti",
  "role": "external_wrench_optimizer",
  "state_order": ["roll", "pitch", "yaw", "px", "py", "pz", "wx", "wy", "wz", "vx", "vy", "vz"],
  "wrench_frame": "world",
  "update_period_s": 0.02,
  "prediction_dt_s": 0.02,
  "horizon_steps": 3,
  "sqp_iterations_per_update": 1,
  "input_weight": 2e-6,
  "wrench_rate_weight": 1e-7,
  "state_weights": [4.0, 4.0, 2.0, 1.0, 30.0, 30.0, 0.1, 0.1, 0.1, 5.0, 20.0, 5.0],
  "state_difference": 1e-5,
  "wrench_difference": 0.001,
  "solver": "finite-difference SQP-RTI plus OSQP",
  "failure_policy": "fallback_to_internal_cpp_convex_mpc"
}
